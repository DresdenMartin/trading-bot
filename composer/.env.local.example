# ── Alpaca Brokerage ──────────────────────────────────────────────────────────
ALPACA_KEY=
ALPACA_SECRET=
ALPACA_PAPER=true

# ── OpenAI ────────────────────────────────────────────────────────────────────
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_WEB_MODEL=gpt-4o-mini

# ── Anthropic / Claude ────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=

# ── Polygon.io ────────────────────────────────────────────────────────────────
POLYGON_KEY=

# ── Supabase (create project at supabase.com) ────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key   # for strategy_executor.py

# ── Next.js App ───────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
BACKTEST_URL=http://localhost:8001

# ── Trading Engine (optional overrides) ───────────────────────────────────────
PLACE_ORDER=false
REALLOCATE_FULL=false
TOP_ALLOCATE_COUNT=3
INVEST_TOTAL_PCT=0.01
USE_WEB_RESEARCH=false
SYMBOLS=AAPL,MSFT,NVDA,AMZN,META,GOOGL,TSLA
EXTENDED_HOURS=false
EXTENDED_HOURS_LIMIT_PCT=0.01

# ── Dashboard Server ──────────────────────────────────────────────────────────
DASHBOARD_TOKEN=
DASHBOARD_PORT=8000

# ── Caching / Tuning ─────────────────────────────────────────────────────────
GPT_ARTICLE_CACHE_TTL=1209600
SENTIMENT_CACHE_TTL=2592000
NEWS_WINDOW_HOURS=36
EOD_CACHE_ONLY=false
DEBUG=false
