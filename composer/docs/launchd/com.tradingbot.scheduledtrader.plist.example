<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.tradingbot.scheduledtrader</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>-lc</string>
    <!-- Replace the path below with the absolute path to run_scheduled_trader.sh -->
    <string>/Users/your_user/Desktop/trading-bot/scripts/run_scheduled_trader.sh</string>
  </array>

  <key>WorkingDirectory</key>
  <!-- Replace with your project root -->
  <string>/Users/your_user/Desktop/trading-bot</string>

  <key>StartCalendarInterval</key>
  <!-- Runs at 08:45 Eastern (adjust Hour/Minute as needed) -->
  <dict>
    <key>Hour</key>
    <integer>8</integer>
    <key>Minute</key>
    <integer>45</integer>
  </dict>

  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>

  <key>StandardOutPath</key>
  <string>/Users/your_user/Desktop/trading-bot/logs/launchd-scheduled_trader.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/your_user/Desktop/trading-bot/logs/launchd-scheduled_trader.log</string>
</dict>
</plist>
